{
  "name": "mdflix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MDFlix — platform streaming full-stack (Vite + React, Vercel Functions, Supabase).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "prebuild": "node scripts/verify-entry.mjs",
    "build": "vite build",
    "start": "node scripts/serve.js",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "test": "node --test --test-concurrency=1 tests/content/*.test.mjs tests/sql/*.test.mjs tests/api/*.test.mjs",
    "test:sql": "node --test --test-concurrency=1 tests/sql/*.test.mjs",
    "test:api": "node --test --test-concurrency=1 tests/api/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:content": "node --test --test-concurrency=1 tests/content/*.test.mjs",
    "smoke:content": "node scripts/smoke-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.0",
    "@fontsource-variable/figtree": "^5.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "@vitejs/plugin-react": "^4.3.0",
    "hls.js": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "vite": "^5.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pg": "^8.13.0",
    "puppeteer-core": "^23.0.0"
  }
}
