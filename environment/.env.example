# ─────────────────────────────────────────────────────────────────────────────
# MDFlix — contoh environment variable.  Salin ke .env (lokal) atau isi di
# Vercel → Project → Settings → Environment Variables.
# JANGAN commit .env asli. Semua nilai di bawah sengaja KOSONG.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────────────────────
SUPABASE_URL=
# Boleh tampil di browser (dikirim lewat /api/config/public).
SUPABASE_PUBLISHABLE_KEY=
# RAHASIA — hanya server. Jangan pernah diberi awalan VITE_ dan jangan dikirim ke browser.
SUPABASE_SECRET_KEY=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Kedua nilai ini DIISI DI DASHBOARD SUPABASE (Authentication → Providers → Google),
# bukan dibaca oleh aplikasi. Di sini hanya untuk Supabase CLI lokal (supabase/config.toml).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Content API (SEMUA OPSIONAL) ─────────────────────────────────────────────
# Tanpa variabel ini aplikasi memakai API MDFlix Original yang sudah tertanam di source
# (server/content/providers/original.js). Anda tidak perlu mengisi apa pun agar katalog & playback jalan.
#
# Isi CONTENT_API_BASE_URL HANYA bila host API original pindah (host-nya sudah berganti antar versi project).
# Bentuk yang diterima: https://host  atau  https://host/api/movies
CONTENT_API_BASE_URL=
# original (default; "legacy" = alias) | native (kontrak internal MDFlix, wajib CONTENT_API_BASE_URL)
# | fixture (data fiktif untuk pengembangan offline; di produksi ditolak → katalog 503, tidak pernah tampil)
CONTENT_API_DIALECT=

# ── Situs ────────────────────────────────────────────────────────────────────
# URL publik produksi, mis. https://mdflix.vercel.app (untuk og:image & redirect).
SITE_URL=
