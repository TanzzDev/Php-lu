# ─────────────────────────────────────────────────────────────────────────────
# MDFlix — contoh environment variable.  Salin ke .env (lokal) atau isi di
# Vercel → Project → Settings → Environment Variables.
# JANGAN commit .env asli. Semua nilai di bawah sengaja KOSONG.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────────────────────
SUPABASE_URL=
# Boleh tampil di browser (dikirim lewat /api/config/public).
SUPABASE_PUBLISHABLE_KEY=
# RAHASIA — hanya server. Jangan pernah diberi awalan VITE_ dan jangan dikirim ke browser.
SUPABASE_SECRET_KEY=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Kedua nilai ini DIISI DI DASHBOARD SUPABASE (Authentication → Providers → Google),
# bukan dibaca oleh aplikasi. Di sini hanya untuk Supabase CLI lokal (supabase/config.toml).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Content API ──────────────────────────────────────────────────────────────
# Kosong = data fixture pengembangan (TIDAK aktif di produksi).
# Isi dengan base URL API katalog film/series yang Anda punya hak untuk memakainya
# (API resmi/berlisensi, atau layanan Anda sendiri) — bukan URL yang dicontohkan di sini.
CONTENT_API_BASE_URL=
# legacy = tata letak endpoint lama: /api/movies/popular|latest|upcoming|top-rated|search|detail/{slug}
# native = kontrak internal MDFlix: /api/movies, /api/movies/{id}, /api/series/{id}, … (lihat docs/CONTENT_API.md)
CONTENT_API_DIALECT=legacy

# ── Situs ────────────────────────────────────────────────────────────────────
# URL publik produksi, mis. https://mdflix.vercel.app (untuk og:image & redirect).
SITE_URL=
